-- lua header. Keep this line: it makes the file be read as UTF-8.
-- Development configuration of the Login Server (tag DEV: LoginServer DEV <server group id>).
-- Derived from the production config_lg_US_SERVICE.lua. The @...@ values are filled in by the
-- x2_run_login target (docs/tools/runtime.md).

-- address this server announces; the DB (Statistics.LServerList.PublicIP) identifies the servers by it --
SetLocalIP( "@X2_SERVER_IP@" )

----------     Login Server     ----------

-- time to wait for the DB queue on shutdown --
Server:SetShutDownWait( 60 * 1000 )


----------     Login SimLayer     ----------

-- Auth Flag --
--[[
AF_INTERNAL       : in-house auth
AF_GLOBAL_SERVICE : global service (DEB)
--]]
SimLayer:SetAuthFlag( AF_GLOBAL_SERVICE )

-- Script File Path (relative to this folder: dist/LoginServer) --
SimLayer:AddPath( os.getenv("X2_SERVERRESOURCE_DIR") or "@X2_SERVERRESOURCE_DIR@" ) -- server common
SimLayer:AddPath( os.getenv("X2_CLIENTSCRIPT_DIR") or "@X2_CLIENTSCRIPT_DIR@" ) -- client script, generated from the client data

-- wait for the authentication before letting a duplicated login in --
SimLayer:SetEnableAuthWait( true )


----------     DB Layer     ----------

-- ODBC driver (docs/porting/server-common-db.md); must come before AddDB --
DBLayer:SetODBCDriver( "@X2_ODBC_DRIVER@" )
DBLayer:SetODBCOptions( "@X2_ODBC_OPTIONS@" )

-- databases --
--[[
DC_ACCOUNT     : accounts
DC_GAME        : game
DC_LOG         : statistics
DC_KOG_BILLING : billing (cash)
--]]
-- AddDB( DB type, file dsn, thread count, DBConnectionString? )
-- Production had Game01/Game02 by server group, both pointing to the same Game01 database.

DBLayer:AddDB( DC_ACCOUNT,		'Account.dsn',		20, false )
DBLayer:AddDB( DC_LOG,			'Statistics.dsn',	 5, false )
DBLayer:AddDB( DC_GAME,			'Game01.dsn',		15, false )
DBLayer:AddDB( DC_KOG_BILLING,	'Billing.dsn',		 5, false )


----------     Log level     ----------

-- log level --
--[[
-1 : no logs
 0 : cerr, cout
 1 : cerr, cwarn, cout
 2 : cerr, cwarn, clog, cout
--]]
log( 0 )
